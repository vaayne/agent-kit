{
  "id": "phonemanager",
  "name": "平板管家/手机管家 com.coloros.phonemanager",
  "package": "com.coloros.phonemanager",
  "steps": [
    { "do": "launch", "pkg": "com.coloros.phonemanager" },
    { "do": "tap", "text": "更多选项" },
    { "do": "tap", "text": "设置" },
    { "do": "off", "titles": ["工具推荐"] },
    { "do": "keep", "titles": ["常用工具"] },
    { "do": "tap", "text": "消息管理" },
    { "do": "keep", "titles": ["风险应用运行提示", "USB 调试模式提醒", "相册最近删除提醒"] },
    { "do": "back" },
    { "do": "tap", "text": "隐私" },
    { "do": "off", "titles": ["个性化内容推荐"] },
    { "do": "keep", "titles": ["平板管家服务", "手机管家服务"] }
  ]
}
