#!/usr/bin/env bash
#MISE description="Mirror local and remote skills into ~/.agents/skills"

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$0")/../../.." && pwd)
SKILL_SOURCE_DIR="$ROOT_DIR/skills"
# Agent Kit owns this directory. Sync deletes skills that are not in the repo or
# the remote registry.
TARGET="$HOME/.agents/skills/"

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent-kit/skills"
REMOTE_SKILL_DIR="$CACHE_DIR/remote"
REMOTE_SKILL_REGISTRY="$SKILL_SOURCE_DIR/remote-skills.txt"
declare -a repos=() skills=() specs=() versions=()

sync_remote_skills() {
  local cache_dir="$CACHE_DIR"
  local stamp="$cache_dir/remote-skills.sha256"
  local registry_hash mode repo skill_spec extra skill spec version
  local index target log failed
  local -a pids=()

  mkdir -p "$cache_dir"
  registry_hash=$(shasum -a 256 "$REMOTE_SKILL_REGISTRY" | awk '{print $1}')
  mode=update
  if [[ ! -f "$stamp" ]] || [[ $(cat "$stamp") != "$registry_hash" ]]; then
    mode=install
    # A full reinstall also drops cached skills that left the registry.
    rm -rf "$REMOTE_SKILL_DIR"
  fi
  mkdir -p "$REMOTE_SKILL_DIR"

  while read -r repo skill_spec extra || [[ -n "${repo:-}" ]]; do
    case "$repo" in
      "" | \#*) continue ;;
    esac

    if [[ -z "${skill_spec:-}" ]] || [[ -n "${extra:-}" ]]; then
      echo "Invalid remote skill entry: $repo ${skill_spec:-} ${extra:-}" >&2
      return 1
    fi

    skill="$skill_spec"
    version=""
    if [[ "$skill_spec" == *@* ]]; then
      version=${skill_spec##*@}
      skill=${skill_spec%@*}
      if [[ -z "$skill" ]] || [[ -z "$version" ]]; then
        echo "Invalid pinned skill entry: $repo $skill_spec" >&2
        return 1
      fi
    fi

    # A registry entry names a skill, not a directory: it may be a bare name, a
    # path inside the repository, or a path that ends in SKILL.md. The installed
    # directory takes the last path segment, because gh skill names the directory
    # after the upstream path.
    name="${skill%/}"
    name="${name%/SKILL.md}"
    name="${name##*/}"

    case "$name" in
      "" | . | .. | *[!a-z0-9-]*)
        echo "Invalid skill directory name: $skill" >&2
        return 1
        ;;
    esac
    if [[ -e "$SKILL_SOURCE_DIR/$name" ]]; then
      echo "Local and remote skill names collide: $skill" >&2
      return 1
    fi
    for target in "${skills[@]+"${skills[@]}"}"; do
      if [[ "$target" == "$name" ]]; then
        echo "Remote skill names collide: $skill" >&2
        return 1
      fi
    done

    repos+=("$repo")
    skills+=("$name")
    specs+=("$skill")
    versions+=("$version")
  done < "$REMOTE_SKILL_REGISTRY"

  local tmp_dir
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "$tmp_dir"' RETURN

  # The registry is deliberately small. Use a bounded worker queue if it grows
  # past 10 entries; until then, one process per entry is simpler and faster.
  for index in "${!repos[@]}"; do
    repo=${repos[$index]}
    skill=${skills[$index]}
    spec=${specs[$index]}
    version=${versions[$index]}
    target="$REMOTE_SKILL_DIR/$skill"
    log="$tmp_dir/$index.log"

    (
      if [[ "$mode" == update ]] && [[ -e "$target" ]]; then
        if [[ -n "$version" ]]; then
          echo "Pinned skill already installed: $repo $spec@$version"
        else
          echo "Checking skill: $repo $spec"
          gh skill update "$skill" --all --dir "$REMOTE_SKILL_DIR"
        fi
      elif [[ -n "$version" ]]; then
        echo "Installing pinned skill: $repo $spec@$version"
        gh skill install "$repo" "$spec" \
          --pin "$version" --dir "$REMOTE_SKILL_DIR" --force
      else
        echo "Installing skill: $repo $spec"
        gh skill install "$repo" "$spec" --dir "$REMOTE_SKILL_DIR" --force
      fi
    ) >"$log" 2>&1 &
    pids+=("$!")
  done

  failed=0
  for index in "${!pids[@]}"; do
    if wait "${pids[$index]}"; then
      cat "$tmp_dir/$index.log"
    else
      cat "$tmp_dir/$index.log" >&2
      failed=1
    fi
  done

  if (( failed )); then
    echo "Remote skill sync failed" >&2
    return 1
  fi

  printf '%s\n' "$registry_hash" > "$stamp.tmp"
  mv "$stamp.tmp" "$stamp"
  echo "Remote skills synced"
}

if [[ -f "$REMOTE_SKILL_REGISTRY" ]]; then
  sync_remote_skills
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir "$stage/skills"
rsync -a --exclude=remote-skills.txt --exclude=__pycache__ --exclude=.ruff_cache \
  "$SKILL_SOURCE_DIR/" "$stage/skills/"
for skill in "${skills[@]+"${skills[@]}"}"; do
  source="$REMOTE_SKILL_DIR/$skill"
  if [[ ! -f "$source/SKILL.md" ]]; then
    echo "Remote skill is missing SKILL.md: $source" >&2
    exit 1
  fi
  # Agents load a skill only when its directory matches the SKILL.md name, and
  # gh skill names the directory after the upstream path.
  name=$(awk '/^---$/ { n++; next } n == 1 && /^name:/ { print $2; exit }' \
    "$source/SKILL.md" | tr -d "\"'")
  name=${name:-${skill##*/}}
  case "$name" in
    "" | *[!a-z0-9-]*)
      echo "Invalid skill name in $source/SKILL.md: $name" >&2
      exit 1
      ;;
  esac
  if [[ -e "$stage/skills/$name" ]]; then
    echo "Skill names collide: $name" >&2
    exit 1
  fi
  rsync -a "$source/" "$stage/skills/$name/"
done

mkdir -p "$TARGET"
rsync -a --checksum --delete --itemize-changes "$stage/skills/" "$TARGET"
echo "Synced Agent Kit skills to $TARGET"
