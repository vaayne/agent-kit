#!/usr/bin/env bash
#MISE description="Sync local and remote skills to the BB server"

set -euo pipefail

ROOT_DIR=$(cd "$(dirname "$0")/../../.." && pwd)
SKILL_SOURCE_DIR="$ROOT_DIR/skills"
if [[ $# -gt 1 ]]; then
  echo "Usage: mise run sync:skills -- [ssh-host:]<bb-data-dir>/skills/" >&2
  exit 2
fi
BB_TARGET="${1:-${BB_SKILLS_TARGET:-}}"
if [[ -z "$BB_TARGET" ]]; then
  echo "Set BB_SKILLS_TARGET to [ssh-host:]<bb-data-dir>/skills/, or pass the target." >&2
  exit 2
fi
case "$BB_TARGET" in
  */skills/) ;;
  *) echo "BB skills target must end with /skills/: $BB_TARGET" >&2; exit 2 ;;
esac

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/agent-kit/bb-skills"
REMOTE_SKILL_DIR="$CACHE_DIR/remote"
REMOTE_SKILL_REGISTRY="$SKILL_SOURCE_DIR/remote-skills.txt"
declare -a repos=() skills=() versions=()

sync_remote_skills() {
  local cache_dir="$CACHE_DIR"
  local stamp="$cache_dir/remote-skills.sha256"
  local registry_hash mode repo skill_spec extra skill version
  local index target log failed
  local -a pids=()

  mkdir -p "$cache_dir"
  registry_hash=$(shasum -a 256 "$REMOTE_SKILL_REGISTRY" | awk '{print $1}')
  mode=update
  if [[ ! -f "$stamp" ]] || [[ $(cat "$stamp") != "$registry_hash" ]]; then
    mode=install
  fi

  while read -r repo skill_spec extra || [[ -n "${repo:-}" ]]; do
    case "$repo" in
      "" | \#*) continue ;;
    esac

    if [[ -z "${skill_spec:-}" ]] || [[ -n "${extra:-}" ]]; then
      echo "Invalid remote skill entry: $repo ${skill_spec:-} ${extra:-}" >&2
      return 1
    fi

    skill="$skill_spec"
    version=""
    if [[ "$skill_spec" == *@* ]]; then
      version=${skill_spec##*@}
      skill=${skill_spec%@*}
      if [[ -z "$skill" ]] || [[ -z "$version" ]]; then
        echo "Invalid pinned skill entry: $repo $skill_spec" >&2
        return 1
      fi
    fi

    case "${skill##*/}" in
      "" | . | .. | *[!a-z0-9-]*)
        echo "Invalid skill directory name: $skill" >&2
        return 1
        ;;
    esac
    if [[ -e "$SKILL_SOURCE_DIR/${skill##*/}" ]]; then
      echo "Local and remote skill names collide: $skill" >&2
      return 1
    fi
    for target in "${skills[@]+"${skills[@]}"}"; do
      if [[ "${target##*/}" == "${skill##*/}" ]]; then
        echo "Remote skill names collide: $skill" >&2
        return 1
      fi
    done

    repos+=("$repo")
    skills+=("$skill")
    versions+=("$version")
  done < "$REMOTE_SKILL_REGISTRY"

  local tmp_dir
  tmp_dir=$(mktemp -d)
  trap 'rm -rf "$tmp_dir"' RETURN

  # The registry is deliberately small. Use a bounded worker queue if it grows
  # past 10 entries; until then, one process per entry is simpler and faster.
  for index in "${!repos[@]}"; do
    repo=${repos[$index]}
    skill=${skills[$index]}
    version=${versions[$index]}
    target="$REMOTE_SKILL_DIR/${skill##*/}"
    log="$tmp_dir/$index.log"

    (
      if [[ "$mode" == update ]] && [[ -e "$target" ]]; then
        if [[ -n "$version" ]]; then
          echo "Pinned skill already installed: $repo $skill@$version"
        else
          echo "Checking skill: $repo $skill"
          gh skill update "$skill" --all --dir "$REMOTE_SKILL_DIR"
        fi
      elif [[ -n "$version" ]]; then
        echo "Installing pinned skill: $repo $skill@$version"
        gh skill install "$repo" "$skill" \
          --pin "$version" --dir "$REMOTE_SKILL_DIR" --force
      else
        echo "Installing skill: $repo $skill"
        gh skill install "$repo" "$skill" --dir "$REMOTE_SKILL_DIR" --force
      fi
    ) >"$log" 2>&1 &
    pids+=("$!")
  done

  failed=0
  for index in "${!pids[@]}"; do
    if wait "${pids[$index]}"; then
      cat "$tmp_dir/$index.log"
    else
      cat "$tmp_dir/$index.log" >&2
      failed=1
    fi
  done

  if (( failed )); then
    echo "Remote skill sync failed" >&2
    return 1
  fi

  printf '%s\n' "$registry_hash" > "$stamp.tmp"
  mv "$stamp.tmp" "$stamp"
  echo "Remote skills synced"
}

mkdir -p "$REMOTE_SKILL_DIR"

if [[ -f "$REMOTE_SKILL_REGISTRY" ]]; then
  sync_remote_skills
fi

stage=$(mktemp -d)
trap 'rm -rf "$stage"' EXIT
mkdir "$stage/skills"
rsync -a --exclude=remote-skills.txt "$SKILL_SOURCE_DIR/" "$stage/skills/"
for skill in "${skills[@]+"${skills[@]}"}"; do
  source="$REMOTE_SKILL_DIR/${skill##*/}"
  if [[ ! -f "$source/SKILL.md" ]]; then
    echo "Remote skill is missing SKILL.md: $source" >&2
    exit 1
  fi
  rsync -a "$source/" "$stage/skills/${skill##*/}/"
done

backup_dir="../skill-backups/agent-kit-$(date -u +%Y%m%dT%H%M%SZ)-$$"
rsync -a --checksum --delay-updates --backup --backup-dir="$backup_dir" \
  "$stage/skills/" "$BB_TARGET"
echo "Synced local and remote Agent Kit skills to $BB_TARGET"
